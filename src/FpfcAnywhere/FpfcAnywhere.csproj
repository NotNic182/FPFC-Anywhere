<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>FpfcAnywhere</RootNamespace>
    <AssemblyName>FpfcAnywhere</AssemblyName>
    <Version>0.2.0</Version>
    <DebugType>portable</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/_</PathMap>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\FpfcAnywhere.Core\**\*.cs" Exclude="..\FpfcAnywhere.Core\obj\**;..\FpfcAnywhere.Core\bin\**" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(BeatSaberManaged)UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(BeatSaberManaged)UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(BeatSaberManaged)UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.SubsystemsModule"><HintPath>$(BeatSaberManaged)UnityEngine.SubsystemsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(BeatSaberManaged)UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.VRModule"><HintPath>$(BeatSaberManaged)UnityEngine.VRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.XRModule"><HintPath>$(BeatSaberManaged)UnityEngine.XRModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(BeatSaberManaged)Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Core.Runtime"><HintPath>$(BeatSaberManaged)Unity.RenderPipelines.Core.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.Universal.Runtime"><HintPath>$(BeatSaberManaged)Unity.RenderPipelines.Universal.Runtime.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
